#!/bin/bash
# ==========================================================================
# スタジアムビジョン得点板 - サーバー起動（Mac用）
#   ダブルクリックすると「ターミナル」が開き、サーバーが起動して管理画面がブラウザで開く
# ==========================================================================
cd "$(dirname "$0")" || exit 1
# Node.js の公式インストーラー（/usr/local/bin）と Homebrew（/opt/homebrew/bin）の場所も探す
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"

echo "======================================================"
echo " スタジアムビジョン得点板のサーバーを起動しています..."
echo " 準備ができると、管理画面が自動でブラウザに開きます。"
echo " このターミナルの画面は、試合が終わるまで閉じずにそのままにしてください。"
echo "======================================================"

if ! command -v node > /dev/null 2>&1; then
    echo
    echo "[エラー] このMacには Node.js が入っていないため、起動できません。"
    echo "        https://nodejs.org/ja から「LTS」版を入れてから、もう一度起動してください。"
    echo
    read -r -p "Enterキーを押すと閉じます" _
    exit 1
fi

node server.js --open
echo
read -r -p "Enterキーを押すと閉じます" _
